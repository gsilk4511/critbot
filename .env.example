# Keep a private copy named .env on the Docker host and fill in these values.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://bot.flickthecrit.com/auth/discord/callback
CRITBOT_GUILD_ID=
CRITBOT_OWNER_DISCORD_ID=

# Preserve the existing secret when migrating. For a new secret, use openssl rand -hex 32.
CRITBOT_DASHBOARD_SECRET=
CRITBOT_ALLOW_HTTP_LOCAL=0
CRITBOT_DB=/app/data/critbot.db
CRITBOT_DASHBOARD_PORT=5000

# Optional. Supply numeric channel IDs to override the app defaults.
# CRITBOT_ANNOUNCEMENT_CHANNEL_ID=
# CRITBOT_ADMIN_CHANNEL_ID=
# CRITBOT_PREMIUM_SKU_ID=
# CLOUDFLARE_TUNNEL_TOKEN=

# Set these as stack variables in Portainer, or uncomment them for local Docker Compose.
# CRITBOT_DATA_DIR=/absolute/path/to/existing/critbot/data
# CRITBOT_ENV_FILE=/absolute/path/to/critbot/.env
# CRITBOT_DOCKER_NETWORK=eth0
